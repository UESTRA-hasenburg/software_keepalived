# Checkmk local check for keepalived monitoring
# displays the state of each VRRP instance in a HA cluster with keepalived
# The check state is OK for VRRP states MASTER or BACKUP, CRIT for FAULT,
# and UNKNOWN otherwise.
#
# example output:
# 0 Keepalived_VRRP_VI_1 - VRRP instance VI_1 is in state BACKUP.

import glob
import os

def main():
    # Suche nach Statusdateien von keepalived
    state_files = glob.glob('/var/run/keepalived.*.*.state')

    for file_path in state_files:
        try:
            with open(file_path, 'r') as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue

                    # Zeilenformat: TYPE:NAME:STATE
                    parts = line.split(':')
                    if len(parts) < 3:
                        continue

                    vrrp_type, name, state = parts[0], parts[1], parts[2]

                    if vrrp_type != "INSTANCE":
                        continue

                    # Status bestimmen
                    # 0 = OK, 2 = CRIT, 3 = UNKNOWN
                    if state in ["MASTER", "BACKUP"]:
                        status_code = 0
                    elif state == "FAULT":
                        status_code = 2
                    else:
                        status_code = 3

                    print(f"{status_code} Keepalived_VRRP_{name} - VRRP instance {name} is in state {state}.")
        except (IOError, OSError):
            continue

if __name__ == "__main__":
    main()
